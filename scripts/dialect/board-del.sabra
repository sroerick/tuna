; board-del.sabra — Midden-backed tombstone delete (board v2).
;
; Reads current head via `midden/get` and appends a tombstone commit via
; `midden/delete`, preserving commit history while retracting the item from
; `todo_by_created`, `todo_open`, and `todo_counts`.

(lambda (entity)
  (let ((got (prim "midden/get" "todo" entity)))
    (prim "midden/delete" "todo" entity (first got))))
