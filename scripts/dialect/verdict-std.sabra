;; verdict-std.sabra - the gate-receipt verdict (scripts/gate-receipts/
;; verdict.sabra) written against the shared stdlib instead of carrying
;; its helpers inline (borg/tool-language.borg T2 + T3).  Every stdlib
;; name is pinned to the 12-hex prefix of its stdlib/v1/manifest hash, so
;; the source compiles only against a dictionary that still holds those
;; exact trees.  scripts/verify-15-tool-language.sh posts it to
;; /api/programs and requires verdict.sabra's program hash.
;;
;; Inputs: obs (the observation record), skip-allowed (gate slugs).
;; Output: %10 pass, %110 fail, %1110 unverified.
;; Field tags: #1 gate, #5 tree_clean, #6 diff_hash, #7 exit, #9 counts.

(lambda (obs)
  (lambda (skip-allowed)
    (let
      ((gate (rec-val@ee621cc3fc56 #1 obs))
       (tree-clean (rec-val@ee621cc3fc56 #5 obs))
       (diff-hash (rec-val@ee621cc3fc56 #6 obs))
       (exit-status (rec-val@ee621cc3fc56 #7 obs))
       (counts (rec-val@ee621cc3fc56 #9 obs)))
      (let
        ((parsed (is-fork@47ae0411eabb counts))
         (run (first@a39abbda611d counts))
         (failed (first@a39abbda611d (second@5f8ec503a876 (second@5f8ec503a876 counts))))
         (skipped (first@a39abbda611d (second@5f8ec503a876 (second@5f8ec503a876 (second@5f8ec503a876 counts)))))
         (skip-member
           (list-fold@46968fedc294
             (lambda (slug) (lambda (acc) (bool-or@1c807b3af127 (tree-eq@b5f7c54b1358 slug gate) acc)))
             %0
             skip-allowed)))
        ;; the chapter's v1 policy, top to bottom: first match wins.
        ;; cond leans on the dictionary's if, which a cond form cannot pin:
        ;; it is the one unpinned name, and the compile's lock reports it.
        (cond
          ((not@336e50127a42 (tree-eq@b5f7c54b1358 exit-status %200)) %110)
          ((not@336e50127a42 parsed) %1110)
          ((tree-eq@b5f7c54b1358 run %200) %1110)
          ((not@336e50127a42 (tree-eq@b5f7c54b1358 failed %200)) %110)
          ((bool-and@42812bbc6b1b (not@336e50127a42 (tree-eq@b5f7c54b1358 skipped %200)) (not@336e50127a42 skip-member)) %1110)
          ((bool-and@42812bbc6b1b (tree-eq@b5f7c54b1358 tree-clean %200) (is-leaf@17ba206e31b9 diff-hash)) %1110)
          (else %10))))))
