; board-add.sabra — Midden-backed board create (board v2).
;
; Builds a canonical `todo` v1 record (tags 1..4 in byte-sorted field order:
; 1=created, 2=state, 3=title, 4=who) and writes it through `midden/put`
; with prev="" (create).  Midden atomically updates `todo_by_created` and
; `todo_counts` in the same transaction.

(lambda (entity)
  (lambda (title)
    (lambda (who)
      (lambda (created)
        (prim "midden/put" "todo" entity ""
          (pair (pair %10 (pair created %0))
            (pair (pair %110 (pair "open" %0))
              (pair (pair %1110 (pair title %0))
                (pair (pair %11110 (pair who %0)) %0)))))))))
