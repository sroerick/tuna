; board-flip.sabra — Midden-backed optimistic-CAS toggle (board v2).
;
; Reads `(pair head doc)` via `midden/get`, flips tag 2 (`state`) between
; "open" and "done" with stdlib `rec-val` + `rec-upd`, and writes back via
; `midden/put` citing `head` so a raced flip fails with a journaled conflict.

(lambda (entity)
  (let ((got (prim "midden/get" "todo" entity)))
    (let ((head (first got)))
      (let ((doc (second got)))
        (let ((next (if "done" "open" (tree-eq (rec-val %110 doc) "open"))))
          (prim "midden/put" "todo" entity head
            (rec-upd %110 next doc)))))))
