; same JSON as POST /api/tool/run.
(rule
 (alias runtest)
 (deps cli_local.sh ../scripts/gate-receipts/verdict.sabra
  %{exe:../cli/bin/main.exe}
  %{exe:../tools/deriv-check/deriv_check.exe})
 (action
  (run bash %{dep:cli_local.sh} %{exe:../cli/bin/main.exe}
   %{exe:../tools/deriv-check/deriv_check.exe}
   %{workspace_root}/scripts/gate-receipts/verdict.sabra)))
