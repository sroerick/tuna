; math prim differential (borg/math-prims.borg acceptance 1): embed the
; stdlib transcript for the in-test reference compile (same rule shape
; as server/lib/dune's stdlib_embed)
(rule
 (target stdlib_defs_test.ml)
 (deps ../stdlib/v1/core.defs ../tools/stdprobe/embed.py)
 (action
  (with-stdout-to %{target}
   (run python3 %{workspace_root}/tools/stdprobe/embed.py
     %{workspace_root}/stdlib/v1/core.defs))))

