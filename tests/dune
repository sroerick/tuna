  ../scripts/gate-receipts/verdict.sabra
  ../scripts/dialect/verdict-std.sabra
  ../reference/jay-typing-rules/trees
  ../reference/jay-typing-rules/vectors)
 (action
  (run %{exe:tool_language_tests.exe})))

