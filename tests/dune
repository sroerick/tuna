; M5 store integration tests: require a live postgres (scripts/dev.sh
; start-pg); skipped silently when it is down.  The migrations tree is
; passed in so the test executable can bootstrap a fresh cluster.
(rule
 (alias runtest)
 (deps store_tests.exe ../scripts/test-store.sh (source_tree ../migrations))
 (action
  (bash
   "bash %{workspace_root}/scripts/test-store.sh %{exe:store_tests.exe} ../migrations")))

; M10 substrate integration tests: same PG gate as store_tests, but on
; its own scratch database so the two suites never share one (dune
; runs alias rules in parallel).
(rule
 (alias runtest)
 (deps tree_substrate_tests.exe ../scripts/test-store.sh (source_tree ../migrations))
 (action
  (bash
   "bash %{workspace_root}/scripts/test-store.sh %{exe:tree_substrate_tests.exe} ../migrations tuna_test_sub")))

; M11 acceptance tests (byte values, routes as paths, tree/del): same PG
; gate, its own scratch database so the three PG suites never share one.
(rule
 (alias runtest)
 (deps m11_tests.exe ../scripts/test-store.sh (source_tree ../migrations))
 (action
  (bash
   "bash %{workspace_root}/scripts/test-store.sh %{exe:m11_tests.exe} ../migrations tuna_test_m11")))

; M3 differential harness: three engines (instrumented upstream copy,
; CL reference twin, tuna CLI) must agree on every corpus entry.
; Skipped silently when sbcl is not installed.
(rule
 (alias runtest)
 (deps
  ../scripts/verify-differential.sh
  ../reference/tree-calc.lisp
  (source_tree ../scripts/diff-corpus))
 (action
  (bash "command -v sbcl >/dev/null 2>&1 && bash %{workspace_root}/scripts/verify-differential.sh || echo 'sbcl missing: differential harness skipped'")))
