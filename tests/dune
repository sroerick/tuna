; demand-memo (borg/sharing.borg): PG-gated, own scratch db
(rule
 (alias runtest)
 (deps demand_tests.exe ../scripts/test-store.sh (source_tree ../migrations))
 (action
  (bash
   "bash %{workspace_root}/scripts/test-store.sh %{exe:demand_tests.exe} ../migrations tuna_test_demand")))

