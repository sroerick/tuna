; M3 differential harness: three engines (instrumented upstream copy,
; CL reference twin, tuna CLI) must agree on every corpus entry.
; Skipped (with a message) only when sbcl is not installed; a harness
; failure fails runtest.
(rule
 (alias runtest)
 (deps
  ../scripts/verify-differential.sh
  ../reference/tree-calc.lisp
  (source_tree ../scripts/diff-corpus))
 (action
  (bash
   "if command -v sbcl >/dev/null 2>&1; then TUNA_DIFF_GEN=%{exe:../tools/gen/gen.exe} TUNA_DIFF_CLI=%{exe:../cli/bin/main.exe} bash %{workspace_root}/scripts/verify-differential.sh; else echo 'sbcl missing: differential harness skipped'; fi")))

