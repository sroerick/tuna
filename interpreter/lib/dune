(library
 (name tuna_interp)
 (modules eval prim_eval accel accel_trees jay_trees flat flat_drive)
 (libraries tuna unix digestif))

; eval-modes E2 (borg/eval-modes.borg): the frozen stdlib trees by hash,
; for recognising compile-time partials of accelerated functions.  The
; file is generated by tools/stdprobe/freeze.ml; never read at runtime.
(rule
 (target accel_trees.ml)
 (deps ../../stdlib/v1/trees ../../tools/stdprobe/embed_trees.py)
 (action
  (with-stdout-to %{target}
   (run python3 %{workspace_root}/tools/stdprobe/embed_trees.py
     %{workspace_root}/stdlib/v1/trees))))

; eval-modes E3: the trees of Barry Jay's checker that fast3 registers
; (helpers by hash, infer / tp / row as families), exported from his
; Rocq development by reference/jay-typing-rules/regen.sh.
(rule
 (target jay_trees.ml)
 (deps ../../reference/jay-typing-rules/natives ../../tools/stdprobe/embed_jay.py)
 (action
  (with-stdout-to %{target}
   (run python3 %{workspace_root}/tools/stdprobe/embed_jay.py
     %{workspace_root}/reference/jay-typing-rules/natives))))
